rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /waitlist/{docId} {
      // Waitlist entries contain signup emails — only an authenticated
      // admin (custom claim `admin: true`, see scripts/set-admin-claim.mjs)
      // may read them. Previously `allow read: if true`, which made every
      // signup email publicly readable — that was a real vulnerability.
      allow read: if isAdmin();

      // Anonymous auth (see lib/waitlist.ts) is required to create a
      // waitlist entry; field validation is unchanged from before.
      allow create: if
        request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'source', 'timestamp', 'page', 'userAgent'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 254
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.source in ['popup', 'landing_page_cta']
        && request.resource.data.page is string
        && request.resource.data.page.size() < 500
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() < 200;

      allow update, delete: if false;
    }

    // Best-effort audit trail written by the admin dashboard when a
    // waitlist entry is deleted. Only admins may read/create; never
    // mutated or removed once written.
    match /adminAudit/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Website analytics — anyone can log a pageview; only the admin page reads.
    match /pageviews/{docId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['page', 'referrer', 'visitorId', 'country', 'countryCode', 'region', 'city', 'timestamp', 'userAgent'])
        && request.resource.data.page is string && request.resource.data.page.size() < 500
        && request.resource.data.referrer is string && request.resource.data.referrer.size() < 500
        && request.resource.data.visitorId is string && request.resource.data.visitorId.size() < 64
        && request.resource.data.country is string && request.resource.data.country.size() < 100
        && request.resource.data.countryCode is string && request.resource.data.countryCode.size() < 8
        && request.resource.data.region is string && request.resource.data.region.size() < 100
        && request.resource.data.city is string && request.resource.data.city.size() < 100
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() < 200;

      allow update, delete: if false;
    }

    // Written only by the sendLaunchAnnouncement Cloud Function (Admin SDK
    // bypasses these rules); readable so pages can check whether the app is live.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
