  "description": "Skedaddle marketing site and Cloud Functions — a Next.js (apps/web) monorepo backed by Firebase Hosting/Firestore/Functions.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:tokens": "node packages/tokens/build.mjs",
